    {
      "name": "Upload",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"upload 200\", () => pm.response.to.have.status(200));\r",
              "pm.test(\"returns a file path\", () => {\r",
              "  const p = pm.response.json()[0];\r",
              "  pm.expect(p).to.be.a(\"string\");\r",
              "  pm.collectionVariables.set(\"file_path\", p.replace(/\\\\/g, \"\\\\\\\\\"));\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "files",
              "type": "file",
              "id": 0,
              "fileUploadError": "",
              "src": [
                "e:\\Surgical-YOLO-Position-Aware-Attention\\demo\\gallery\\frames\\10-1_10_Video2_00057.jpg"
              ]
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/gradio_api/upload",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "gradio_api",
            "upload"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Run segmentation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"200 and event_id\", () => {\r",
              "  pm.response.to.have.status(200);\r",
              "  const id = pm.response.json().event_id;\r",
              "  pm.expect(id).to.be.a(\"string\");\r",
              "  pm.collectionVariables.set(\"event_id\", id);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "   {\"data\": [{\"path\": \"{{file_path}}\", \"meta\": {\"_type\": \"gradio.FileData\"}}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/gradio_api/call/segment",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "gradio_api",
            "call",
            "segment"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get result",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const text = pm.response.text();\r",
              "pm.test(\"stream ends with complete\", () => pm.expect(text).to.include(\"event: complete\"));\r",
              "pm.test(\"segmentation image returned\", () => {\r",
              "  const line = text.split(\"\\n\").find(l => l.startsWith(\"data: \"));\r",
              "  pm.expect(JSON.parse(line.slice(6))[0].url).to.be.a(\"string\");\r",
              "});\r",
              "pm.test(\"at least one structure detected\", () => {\r",
              "  const line = text.split(\"\\n\").find(l => l.startsWith(\"data: \"));\r",
              "  pm.expect(JSON.parse(line.slice(6))[1].choices.length).to.be.above(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/gradio_api/call/segment/{{event_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "gradio_api",
            "call",
            "segment",
            "{{event_id}}"
          ]
        }
      },
      "response": []
    },
